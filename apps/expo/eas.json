{
  "cli": {
    "version": ">= 4.1.2",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.15.0",
      "pnpm": "11.1.1",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://toki.calayo.net",
        "EXPO_PUBLIC_SENTRY_DSN": "https://b46ee82f149ebdfe930d0b4604f0c351@o4510854102843392.ingest.us.sentry.io/4510854116147200",
        "SENTRY_ORG": "calayo-clothing",
        "SENTRY_PROJECT": "react-native"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "channel": "base"
    },
    "development": {
      "extends": "base",
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000",
        "EXPO_PUBLIC_AUTH_TRACE": "1"
      }
    },
    "preview": {
      "extends": "base",
      "channel": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
